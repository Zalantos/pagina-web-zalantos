---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactSection from '../components/sections/ContactSection.astro'

const title = 'Contacto y Sprint 0 sin costo'
const description =
  'Agenda el Sprint 0: una semana sin costo para mapear tu ciclo de venta a cobro y definir qué automatizar primero.'
const canonical = 'https://zalantos.com/contacto/'
---
<BaseLayout title={title} description={description} canonical={canonical} type="website">
  <main id="main-content" class="flex-grow w-full pt-16 md:pt-20">
    <ContactSection />
  </main>
</BaseLayout>

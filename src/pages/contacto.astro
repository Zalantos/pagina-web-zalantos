---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactSection from '../components/sections/ContactSection.astro'

const title = 'Contacto y Agenda tu Sprint 0'
const description =
  'Contáctanos o agenda tu Sprint 0 sin costo: en 1 semana diagnosticamos tu proceso y definimos la solución de automatización o IA.'
const canonical = 'https://zalantos.com/contacto/'
---
<BaseLayout title={title} description={description} canonical={canonical} type="website">
  <main id="main-content" class="flex-grow w-full pt-20">
    <ContactSection />
  </main>
</BaseLayout>

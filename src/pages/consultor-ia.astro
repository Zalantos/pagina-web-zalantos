---
import BaseLayout from '../layouts/BaseLayout.astro'
import ConsultorIAContent from '../components/chat/ConsultorIAContent'

const title = 'Consultor IA de automatización y datos'
const description =
  'Resuelve dudas sobre automatización de procesos, IA y análisis de datos con el Consultor IA de zalantos. Respuestas claras y personalizadas para tu negocio.'
const canonical = 'https://zalantos.com/consultor-ia/'
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="website"
>
  <main class="min-h-screen">
    <ConsultorIAContent client:load />
  </main>
</BaseLayout>

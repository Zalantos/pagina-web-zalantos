---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/ui/Section.astro'
import LinkButton from '../../components/ui/LinkButton.astro'
import { SOLUCIONES, type Solucion } from '../../data/soluciones'
import { LINKS } from '../../lib/constants'
import { breadcrumbSchema, solutionServiceSchema, faqSchema, SITE_URL } from '../../lib/schemas'

export async function getStaticPaths() {
  return SOLUCIONES.map((solucion) => ({
    params: { slug: solucion.slug },
    props: { solucion },
  }))
}

interface Props {
  solucion: Solucion
}

const { solucion } = Astro.props
const canonical = `${SITE_URL}/soluciones/${solucion.slug}/`

const relacionadas = solucion.relacionadas
  .map((slug) => SOLUCIONES.find((s) => s.slug === slug))
  .filter((s): s is Solucion => Boolean(s))

const extraSchemas = [
  solutionServiceSchema({
    name: solucion.titulo,
    description: solucion.description,
    url: canonical,
  }),
  faqSchema(solucion.faq),
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Soluciones', url: `${SITE_URL}/soluciones/` },
    { name: solucion.seoTitle, url: canonical },
  ]),
]
---
<BaseLayout
  title={solucion.seoTitle}
  description={solucion.description}
  canonical={canonical}
  type="website"
  extraSchemas={extraSchemas}
>
  <main id="main-content" class="flex-grow w-full pt-20">
    <Section variant="white" hero>
      <nav class="flex flex-wrap items-center gap-2 text-xs mb-8" aria-label="Navegación de migas de pan">
        <a href={LINKS.home} class="text-[var(--ink-faint)] hover:text-[var(--z-primary)] transition-colors">Inicio</a>
        <span class="text-[var(--ink-faint)]" aria-hidden="true">›</span>
        <a href={LINKS.solutions} class="text-[var(--ink-faint)] hover:text-[var(--z-primary)] transition-colors">Soluciones</a>
        <span class="text-[var(--ink-faint)]" aria-hidden="true">›</span>
        <span class="text-[var(--z-primary)] font-medium">{solucion.fase}</span>
      </nav>

      <div class="max-w-[820px]">
        <span class="eyebrow inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--z-border)] mb-6">
          Etapa {solucion.etapa} · {solucion.fase}
        </span>
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--z-primary)] tracking-tight leading-[1.15] mb-6">
          {solucion.titulo}
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed">
          {solucion.entradilla}
        </p>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-6">
          Dónde está el problema
        </h2>
        <div class="space-y-5">
          {solucion.problema.map((parrafo) => (
            <p class="text-[var(--ink-soft)] leading-relaxed text-base sm:text-lg">{parrafo}</p>
          ))}
        </div>
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[900px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-10">
          Qué hacemos
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
          {solucion.queHacemos.map((bloque, i) => (
            <div>
              <div class="flex items-baseline gap-3 mb-3">
                <span class="font-display text-lg font-bold text-[var(--accent-flat)] leading-none">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)]">
                  {bloque.titulo}
                </h3>
              </div>
              <p class="text-[var(--ink-soft)] leading-relaxed text-sm sm:text-base">
                {bloque.detalle}
              </p>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <Section variant="dark">
      <div class="max-w-[820px] mx-auto">
        <span class="eyebrow !text-white/70 mb-4 inline-block">Dónde entra la IA</span>
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-6">
          Qué resuelve la inteligencia artificial en esta etapa
        </h2>
        <p class="text-white/85 leading-relaxed text-base sm:text-lg">{solucion.ia}</p>
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[820px] mx-auto">
        <div class="rounded-[var(--radius-lg)] border border-[var(--rule)] bg-[var(--ground)] p-6 sm:p-10 text-center">
          <p class="eyebrow mb-3">Efecto en caja</p>
          <p class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--accent)] mb-4">
            {solucion.impacto.dato}
          </p>
          <p class="text-[var(--ink-soft)] leading-relaxed text-base sm:text-lg max-w-[620px] mx-auto">
            {solucion.impacto.detalle}
          </p>
          <p class="mt-6 text-xs text-[var(--ink-faint)] leading-relaxed max-w-[620px] mx-auto">
            Cifra de casos públicos documentados por UiPath, ScienceSoft y McKinsey en múltiples
            industrias.
          </p>
        </div>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-8">
          Esto es para ti si
        </h2>
        <ul class="space-y-4">
          {solucion.paraTi.map((señal) => (
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 text-[var(--accent)] shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-[var(--ink-soft)] text-base sm:text-lg leading-relaxed">{señal}</span>
            </li>
          ))}
        </ul>
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-10">
          Preguntas frecuentes
        </h2>
        <dl class="space-y-8">
          {solucion.faq.map((item) => (
            <div>
              <dt class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)] mb-2">
                {item.pregunta}
              </dt>
              <dd class="text-[var(--ink-soft)] leading-relaxed">{item.respuesta}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--z-primary)] mb-8 text-center">
          Otras etapas del ciclo
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
          {relacionadas.map((rel) => (
            <a
              href={`/soluciones/${rel.slug}/`}
              class="group block rounded-[var(--radius-lg)] border border-[var(--rule)] bg-[var(--panel)] p-6 transition-colors hover:border-[var(--accent-flat)]"
            >
              <span class="eyebrow block mb-2">{rel.fase}</span>
              <span class="font-display font-semibold text-[var(--z-primary)] group-hover:text-[var(--accent)] transition-colors block leading-snug">
                {rel.titulo}
              </span>
            </a>
          ))}
        </div>

        <div class="text-center">
          <p class="text-base sm:text-lg text-[var(--ink-soft)] leading-relaxed mb-8 max-w-[620px] mx-auto">
            ¿Quieres saber cuántos días pierde tu empresa en sus procesos de negocio? 
          </p>
          <LinkButton href={LINKS.schedule} variant="primary" class="w-full sm:w-auto">
            Agenda tu Sprint 0
          </LinkButton>
          <p class="mt-5">
            <a href={LINKS.solutions} class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors">
              Ver el ciclo completo <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/ui/Section.astro'
import Card from '../../components/ui/Card.astro'
import LinkButton from '../../components/ui/LinkButton.astro'
import { SOLUCIONES, FAQ_ORDER_TO_CASH } from '../../data/soluciones'
import { LINKS } from '../../lib/constants'
import { breadcrumbSchema, solutionServiceSchema, faqSchema, SITE_URL } from '../../lib/schemas'

const title = 'Automatizar facturación, cobranza y conciliación'
const description =
  'Automatizamos facturación, cobranza, crédito y conciliación: las cuatro etapas del ciclo de venta a cobro (order to cash), sobre los sistemas que ya usas.'
const canonical = `${SITE_URL}/soluciones/`

const faq = FAQ_ORDER_TO_CASH

const extraSchemas = [
  solutionServiceSchema({
    name: 'Automatización del ciclo order to cash',
    description,
    url: canonical,
  }),
  faqSchema(faq),
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Soluciones', url: canonical },
  ]),
]
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="website"
  extraSchemas={extraSchemas}
>
  <main id="main-content" class="flex-grow w-full pt-20">
    <Section variant="white" hero>
      <div class="max-w-[820px]">
        <span class="eyebrow inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--z-border)] mb-6">
          Soluciones
        </span>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-[var(--z-primary)] tracking-tight leading-[1.1] mb-6">
          Automatizar el <span class="text-[var(--accent)]">ciclo de venta a cobro</span>, etapa por etapa
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed mb-6">
          El ciclo de venta a cobro es el recorrido que va desde que el cliente pide hasta que
          el dinero está en tu caja. Cada día que ese recorrido se alarga es capital de trabajo
          que financias tú.
        </p>
        <p class="text-base sm:text-lg text-[var(--ink-faint)] leading-relaxed">
          Trabajamos en cada actividad del{' '}
          <a
            href="/glosario/order-to-cash/"
            class="underline underline-offset-4 decoration-[var(--rule)] hover:text-[var(--accent)] transition-colors"
          >ciclo order to cash</a>. Integramos los sistemas que ya usas
          y aplicamos inteligencia artificial en los puntos donde el proceso depende de
          interpretar información o de anticipar un comportamiento.
        </p>
      </div>
    </Section>

    <Section variant="gray">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--z-primary)] mb-4 px-4">
          Las cuatro etapas donde se pierden los días
        </h2>
        <p class="text-base sm:text-lg md:text-xl text-[var(--ink-faint)] max-w-[700px] mx-auto px-4">
          Cada una se puede abordar por separado. El mayor efecto en caja aparece cuando dejan
          de estar desconectadas entre sí.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-[1100px] mx-auto">
        {SOLUCIONES.map((sol) => (
          <Card class="flex flex-col">
            <div class="flex items-baseline gap-3 mb-4">
              <span class="font-display text-2xl font-bold text-[var(--accent-flat)] leading-none">
                {sol.etapa}
              </span>
              <span class="eyebrow">{sol.fase}</span>
            </div>
            <h3 class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)] mb-3">
              <a
                href={`/soluciones/${sol.slug}/`}
                class="hover:text-[var(--accent)] transition-colors focus:outline-none focus-visible:underline"
              >
                {sol.titulo}
              </a>
            </h3>
            <p class="text-[var(--ink-faint)] leading-relaxed text-sm sm:text-base flex-1">
              {sol.entradilla}
            </p>
            <div class="mt-5 pt-5 border-t border-[var(--rule)]">
              <p class="font-display text-base sm:text-lg font-semibold text-[var(--accent)] leading-snug mb-3">
                {sol.impacto.dato}
              </p>
              <a
                href={`/soluciones/${sol.slug}/`}
                class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors"
              >
                Ver cómo lo abordamos <span aria-hidden="true">→</span>
              </a>
            </div>
          </Card>
        ))}
      </div>

      <p class="mt-8 md:mt-10 text-center text-xs text-[var(--ink-faint)] max-w-[760px] mx-auto px-4 leading-relaxed">
        Las cifras provienen de casos públicos documentados por UiPath, ScienceSoft y McKinsey
        en múltiples industrias.
      </p>
    </Section>

    <Section variant="white" id="diagnostico-por-etapa">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-4">
          ¿En qué etapa se están perdiendo tus días?
        </h2>
        <p class="text-[var(--ink-faint)] text-base sm:text-lg leading-relaxed mb-8 max-w-[760px]">
          Cada etapa del ciclo order to cash se delata por un síntoma distinto. Si reconoces el
          síntoma de una fila, ahí está el tramo de días que tu empresa puede recuperar.
        </p>

        <div class="z-table-wrap">
          <table class="z-table">
            <caption class="sr-only">
              Etapas del ciclo order to cash que automatiza zalantos, con el síntoma que delata
              cada una y los días de ciclo que se recuperan al resolverla.
            </caption>
            <thead>
              <tr>
                <th scope="col" class="w-[24%]">Etapa</th>
                <th scope="col" class="w-[44%]">Síntoma que la delata</th>
                <th scope="col" class="w-[32%]">Días recuperables</th>
              </tr>
            </thead>
            <tbody>
              {SOLUCIONES.map((sol) => (
                <tr>
                  <th scope="row">
                    <span class="eyebrow block mb-1">{sol.etapa} · {sol.fase}</span>
                    <a
                      href={`/soluciones/${sol.slug}/`}
                      class="text-[var(--z-primary)] hover:text-[var(--accent)] transition-colors underline underline-offset-4 decoration-[var(--rule)]"
                    >
                      {sol.seoTitle}
                    </a>
                  </th>
                  <td>{sol.diagnostico.sintoma}</td>
                  <td>
                    <span class="font-display font-semibold text-[var(--accent)] block mb-1">
                      {sol.diagnostico.dias}
                    </span>
                    <span class="block text-sm text-[var(--ink-faint)] leading-snug">
                      {sol.diagnostico.base}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-sm text-[var(--ink-faint)] leading-relaxed max-w-[760px]">
          Las cifras provienen de casos públicos documentados por UiPath, ScienceSoft y McKinsey
          en múltiples industrias: no son resultados de proyectos de zalantos. Los días que
          recupera tu empresa se miden sobre tu propio ciclo en el Sprint&nbsp;0.
        </p>
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--z-primary)] mb-10 text-center">
          Preguntas frecuentes
        </h2>
        <dl class="space-y-8">
          {faq.map((item) => (
            <div>
              <dt class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)] mb-2">
                {item.pregunta}
              </dt>
              <dd class="text-[var(--ink-soft)] leading-relaxed">{item.respuesta}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[820px] mx-auto text-center">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[var(--z-primary)] mb-4">
          Empieza por saber dónde se pierden tus días
        </h2>
        <p class="text-base sm:text-lg text-[var(--ink-soft)] leading-relaxed mb-8">
          El Sprint 0 es una actividad sin costo para ti en la que mapeamos el proceso o actividad de tu ciclo de negocio, identificamos las fugas
          y proponemos qué automatizar primero según impacto en caja.
        </p>
        <LinkButton href={LINKS.schedule} variant="primary" class="w-full sm:w-auto">
          Agenda tu Sprint 0
        </LinkButton>
      </div>
    </Section>
  </main>
</BaseLayout>

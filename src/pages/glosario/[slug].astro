---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/ui/Section.astro'
import LinkButton from '../../components/ui/LinkButton.astro'
import { GLOSARIO, type TerminoGlosario } from '../../data/glosario'
import { LINKS } from '../../lib/constants'
import {
  breadcrumbSchema,
  definedTermSchema,
  faqSchema,
  pageSchema,
  terminoId,
  SITE_URL,
} from '../../lib/schemas'

export function getStaticPaths() {
  return GLOSARIO.map((termino) => ({
    params: { slug: termino.slug },
    props: { termino },
  }))
}

interface Props {
  termino: TerminoGlosario
}

const { termino } = Astro.props
const canonical = `${SITE_URL}/glosario/${termino.slug}/`

const relacionados = termino.relacionados
  .map((slug) => GLOSARIO.find((t) => t.slug === slug))
  .filter((t): t is TerminoGlosario => Boolean(t))

const breadcrumb = [
  { name: 'Inicio', url: `${SITE_URL}/` },
  { name: 'Glosario', url: `${SITE_URL}/glosario/` },
  { name: termino.termino, url: canonical },
]

const extraSchemas = [
  definedTermSchema(termino),
  // El DefinedTerm es la entidad principal de la página: sin mainEntity, el nodo
  // queda suelto y el motor no sabe que la URL existe para definir ese término.
  pageSchema({
    name: termino.titulo,
    description: termino.description,
    url: canonical,
    mainEntity: { '@id': terminoId(termino.slug) },
    // Conceptos vecinos del término (p. ej. la facturación electrónica y el SII para
    // el DTE): se declaran como mentions, nunca como sameAs del término.
    mentions: (termino.relacionadas ?? []).map((e) => ({
      '@type': 'Thing',
      name: e.nombre,
      sameAs: [e.wikidata, e.url],
    })),
    breadcrumb,
  }),
  faqSchema(termino.faq),
  breadcrumbSchema(breadcrumb),
]
---
<BaseLayout
  title={termino.seoTitle}
  description={termino.description}
  canonical={canonical}
  type="article"
  extraSchemas={extraSchemas}
>
  <main id="main-content" class="flex-grow w-full pt-20">
    <Section variant="white" hero>
      <div class="max-w-[820px]">
        <nav class="flex flex-wrap items-center gap-2 text-xs mb-6" aria-label="Navegación de migas de pan">
          <a href={LINKS.home} class="text-[var(--ink-faint)] hover:text-[var(--accent)] transition-colors">Inicio</a>
          <span class="text-[var(--ink-faint)]" aria-hidden="true">/</span>
          <a href={LINKS.glossary} class="text-[var(--ink-faint)] hover:text-[var(--accent)] transition-colors">Glosario</a>
          <span class="text-[var(--ink-faint)]" aria-hidden="true">/</span>
          <span class="text-[var(--z-primary)]" aria-current="page">{termino.termino}</span>
        </nav>

        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--z-primary)] tracking-tight leading-[1.15] mb-6">
          {termino.titulo}
        </h1>

        {/* Bloque de respuesta directa: es el fragmento que un motor generativo cita,
            así que tiene que entenderse solo, sin el resto de la página. */}
        <p class="respuesta-corta">{termino.definicion}</p>

        {termino.sinonimos.length > 0 && (
          <p class="text-sm text-[var(--ink-faint)] leading-relaxed">
            <span class="eyebrow">También se le llama</span>{' '}
            {termino.sinonimos.join(' · ')}
          </p>
        )}
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[820px] mx-auto space-y-12">
        {termino.secciones.map((seccion) => (
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--z-primary)] mb-4">
              {seccion.pregunta}
            </h2>
            <div class="space-y-5 text-[var(--ink-soft)] leading-relaxed text-base sm:text-lg">
              {seccion.respuesta.map((parrafo) => <p>{parrafo}</p>)}
            </div>
          </div>
        ))}
      </div>
    </Section>

    {termino.tabla && (
      <Section variant="gray">
        <div class="max-w-[1100px] mx-auto">
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-[var(--z-primary)] mb-8">
            {termino.tabla.titulo}
          </h2>
          <div class="z-table-wrap">
            <table class="z-table">
              <caption class="sr-only">{termino.tabla.caption}</caption>
              <thead>
                <tr>
                  {termino.tabla.columnas.map((col) => <th scope="col">{col}</th>)}
                </tr>
              </thead>
              <tbody>
                {termino.tabla.filas.map((fila) => (
                  <tr>
                    {fila.map((celda, i) =>
                      i === 0 ? <th scope="row">{celda}</th> : <td>{celda}</td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </Section>
    )}

    <Section variant="white">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-10">
          Preguntas frecuentes
        </h2>
        <dl class="space-y-8">
          {termino.faq.map((item) => (
            <div>
              <dt class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)] mb-2">
                {item.pregunta}
              </dt>
              <dd class="text-[var(--ink-soft)] leading-relaxed">{item.respuesta}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[900px] mx-auto grid gap-10 md:grid-cols-2">
        {relacionados.length > 0 && (
          <div>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-[var(--z-primary)] mb-4">
              Términos relacionados
            </h2>
            <ul class="space-y-3">
              {relacionados.map((rel) => (
                <li>
                  <a
                    href={`/glosario/${rel.slug}/`}
                    class="font-semibold text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors"
                  >
                    {rel.termino}
                  </a>
                  <span class="block text-sm text-[var(--ink-faint)] leading-snug mt-1">
                    {rel.seoTitle}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {termino.verTambien.length > 0 && (
          <div>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-[var(--z-primary)] mb-4">
              Dónde lo aplicamos
            </h2>
            <ul class="space-y-3">
              {termino.verTambien.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="font-semibold text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="max-w-[820px] mx-auto text-center mt-14">
        <LinkButton href={LINKS.schedule} variant="primary" class="w-full sm:w-auto">
          Agenda tu Sprint 0
        </LinkButton>
      </div>
    </Section>
  </main>
</BaseLayout>

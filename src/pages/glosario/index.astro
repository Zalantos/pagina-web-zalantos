---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/ui/Section.astro'
import LinkButton from '../../components/ui/LinkButton.astro'
import { GLOSARIO } from '../../data/glosario'
import { LINKS } from '../../lib/constants'
import { breadcrumbSchema, definedTermSetSchema, pageSchema, SITE_URL } from '../../lib/schemas'

const title = 'Glosario del ciclo de venta a cobro'
const description =
  'Definiciones de order to cash, DSO, DTE y Sprint 0: los términos del ciclo de venta a cobro y de la automatización de procesos, explicados en una frase.'
const canonical = `${SITE_URL}/glosario/`

const extraSchemas = [
  definedTermSetSchema(GLOSARIO),
  pageSchema({
    name: title,
    description,
    url: canonical,
    type: 'CollectionPage',
    breadcrumb: [
      { name: 'Inicio', url: `${SITE_URL}/` },
      { name: 'Glosario', url: canonical },
    ],
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Glosario', url: canonical },
  ]),
]
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="website"
  extraSchemas={extraSchemas}
>
  <main id="main-content" class="flex-grow w-full pt-20">
    <Section variant="white" hero>
      <div class="max-w-[820px]">
        <span class="eyebrow inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--z-border)] mb-6">
          Glosario
        </span>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-[var(--z-primary)] tracking-tight leading-[1.1] mb-6">
          Glosario del <span class="text-[var(--accent)]">ciclo de venta a cobro</span>
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed">
          Los términos que usamos a diario en el trabajo con clientes, definidos en una frase
          y desarrollados en su propia página. Sin rodeos y sin suponer que ya los conoces.
        </p>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[900px] mx-auto">
        <dl class="space-y-6">
          {GLOSARIO.map((t) => (
            <div class="rounded-[var(--radius-lg)] border border-[var(--rule)] bg-[var(--panel)] p-6 sm:p-8">
              <dt class="font-display text-xl sm:text-2xl font-semibold text-[var(--z-primary)] mb-3">
                <a
                  href={`/glosario/${t.slug}/`}
                  class="hover:text-[var(--accent)] transition-colors focus:outline-none focus-visible:underline"
                >
                  {t.termino}
                </a>
              </dt>
              <dd>
                <p class="text-[var(--ink-soft)] leading-relaxed mb-4">{t.definicion}</p>
                {t.sinonimos.length > 0 && (
                  <p class="text-sm text-[var(--ink-faint)] mb-4">
                    <span class="eyebrow">También</span>{' '}
                    {t.sinonimos.join(' · ')}
                  </p>
                )}
                <a
                  href={`/glosario/${t.slug}/`}
                  class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors"
                >
                  Ver la definición completa <span aria-hidden="true">→</span>
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[820px] mx-auto text-center">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[var(--z-primary)] mb-4">
          ¿Quieres medir tu propio ciclo?
        </h2>
        <p class="text-base sm:text-lg text-[var(--ink-soft)] leading-relaxed mb-8">
          El Sprint 0 es una actividad sin costo en la que mapeamos tu ciclo de venta a cobro,
          medimos los días de cada tramo y proponemos qué automatizar primero.
        </p>
        <LinkButton href={LINKS.schedule} variant="primary" class="w-full sm:w-auto">
          Agenda tu Sprint 0
        </LinkButton>
      </div>
    </Section>
  </main>
</BaseLayout>

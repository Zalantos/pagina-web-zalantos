---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LinkedInCampaignLanding from '../../components/landing/LinkedInCampaignLanding.astro'
import { landingContent } from '../../data/landingCampaigns/no-todos-problemas-operativos-necesitan-ia'

const title = landingContent.meta?.title ?? 'Campaña zalantos'
const description =
  landingContent.meta?.description ??
  'Landing enfocada en Sprint 0 y diagnóstico operativo de zalantos.'
const canonical =
  'https://zalantos.com/lp/no-todos-problemas-operativos-necesitan-ia/'
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="website"
  hideHeader
  hideFooter
  noindex
>
  <LinkedInCampaignLanding content={landingContent} />
</BaseLayout>

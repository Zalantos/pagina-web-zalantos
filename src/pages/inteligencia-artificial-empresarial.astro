---
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/ui/Section.astro'
import LinkButton from '../components/ui/LinkButton.astro'
import { SOLUCIONES } from '../data/soluciones'
import { PATRONES_IA, CRITERIOS_IA, FAQ_IA } from '../data/ia-empresarial'
import { LINKS } from '../lib/constants'
import { breadcrumbSchema, solutionServiceSchema, faqSchema, SITE_URL } from '../lib/schemas'

const title = 'Inteligencia artificial para empresas en Chile'
const description =
  'Dónde aporta la inteligencia artificial en una empresa, cuándo NO corresponde usarla y qué controles de trazabilidad y límites exige. Los cuatro patrones.'
const canonical = `${SITE_URL}/inteligencia-artificial-empresarial/`

const patrones = PATRONES_IA
const faq = FAQ_IA

const extraSchemas = [
  solutionServiceSchema({
    name: 'Inteligencia artificial empresarial aplicada a procesos de negocio',
    description,
    url: canonical,
  }),
  faqSchema(faq),
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Inteligencia artificial empresarial', url: canonical },
  ]),
]
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="website"
  extraSchemas={extraSchemas}
>
  <main id="main-content" class="flex-grow w-full pt-20">
    <Section variant="white" hero>
      <div class="max-w-[820px]">
        <span class="eyebrow inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--z-border)] mb-6">
          IA empresarial
        </span>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-[var(--z-primary)] tracking-tight leading-[1.1] mb-6">
          Inteligencia artificial para empresas <span class="text-[var(--accent)]">donde cambia el resultado</span>
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed mb-6">
          Diseñamos e implementamos IA dentro de procesos que ya están operando —principalmente el
          ciclo de venta a cobro—, con umbrales de confianza que define el negocio y trazabilidad
          completa de cada decisión.
        </p>
        <p class="text-base sm:text-lg text-[var(--ink-faint)] leading-relaxed mb-8">
          Partimos por el proceso y los datos, no por la herramienta. Si tu problema se resuelve
          con reglas explícitas, te lo decimos y no implementamos IA.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <LinkButton href={LINKS.schedule} variant="primary" class="w-full sm:w-auto">
            Agenda tu Sprint 0
          </LinkButton>
          <LinkButton href={LINKS.solutions} variant="secondary" class="w-full sm:w-auto">
            Ver soluciones
          </LinkButton>
        </div>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-6">
          El problema de comenzar por la herramienta
        </h2>
        <div class="space-y-5 text-[var(--ink-soft)] leading-relaxed text-base sm:text-lg">
          <p>
            La mayoría de los proyectos de IA que no llegan a producción no fracasan por la
            tecnología. Fracasan porque se eligió la herramienta antes de entender qué fricción
            operativa se estaba resolviendo, o porque los datos que debían alimentarla no estaban
            en condiciones de hacerlo.
          </p>
          <p>
            Un asistente IA que responde sobre procedimientos desactualizados propaga el error más
            rápido. Un modelo de priorización entrenado sobre datos de cartera incompletos
            prioriza mal con mucha convicción. La IA amplifica lo que hay debajo, en ambas
            direcciones.
          </p>
          <p>
            Por eso el orden importa: primero el proceso y los datos, después el modelo. Y en
            varios casos la conclusión honesta del diagnóstico es que el problema se resuelve
            con integración, reglas explícitas y automatización determinística, sin IA.
          </p>
        </div>
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[900px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-4">
          Los cuatro patrones donde la IA aporta
        </h2>
        <p class="text-[var(--ink-faint)] text-base sm:text-lg leading-relaxed mb-10 max-w-[700px]">
          Casi todo lo que implementamos cae en uno de estos cuatro patrones. Cada uno incluye su límite,
          porque saber cuándo no aplica es parte de saber aplicarlo.
        </p>

        <div class="space-y-8">
          {patrones.map((patron, i) => (
            <div class="rounded-[var(--radius-lg)] border border-[var(--rule)] p-6 sm:p-8">
              <div class="flex items-baseline gap-3 mb-4">
                <span class="font-display text-xl font-bold text-[var(--accent-flat)] leading-none">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)]">
                  {patron.nombre}
                </h3>
              </div>
              <dl class="space-y-3 text-sm sm:text-base">
                <div>
                  <dt class="eyebrow mb-1">Cuándo</dt>
                  <dd class="text-[var(--ink-soft)] leading-relaxed">{patron.cuando}</dd>
                </div>
                <div>
                  <dt class="eyebrow mb-1">Cómo</dt>
                  <dd class="text-[var(--ink-soft)] leading-relaxed">{patron.como}</dd>
                </div>
                <div>
                  <dt class="eyebrow mb-1">Su límite</dt>
                  <dd class="text-[var(--ink-soft)] leading-relaxed">{patron.limite}</dd>
                </div>
              </dl>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <Section variant="gray" id="cuando-si-cuando-no">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-4">
          ¿Cuándo conviene usar IA y cuándo no?
        </h2>
        <p class="text-[var(--ink-faint)] text-base sm:text-lg leading-relaxed mb-8 max-w-[760px]">
          Conviene usar IA cuando el proceso depende de interpretar información sin estructura,
          de emparejar registros sin identificador común o de anticipar un comportamiento. No
          conviene cuando las reglas son explícitas, los casos son pocos, los datos no son
          confiables o el error no tiene tolerancia: en esos escenarios una automatización
          determinística es más barata, más rápida y más fácil de auditar.
        </p>

        <div class="z-table-wrap">
          <table class="z-table">
            <caption class="sr-only">
              Criterios de zalantos para decidir si un problema operativo requiere inteligencia
              artificial o se resuelve mejor sin ella, con la alternativa recomendada en cada caso.
            </caption>
            <thead>
              <tr>
                <th scope="col" class="w-[34%]">Situación operativa</th>
                <th scope="col" class="w-[10%]">¿IA?</th>
                <th scope="col" class="w-[28%]">Por qué</th>
                <th scope="col" class="w-[28%]">Qué corresponde hacer</th>
              </tr>
            </thead>
            <tbody>
              {CRITERIOS_IA.map((c) => (
                <tr>
                  <th scope="row">{c.situacion}</th>
                  <td>
                    <span
                      class:list={[
                        'z-verdict',
                        c.veredicto === 'Sí' ? 'z-verdict-si' : 'z-verdict-no',
                      ]}
                    >
                      {c.veredicto}
                    </span>
                  </td>
                  <td>{c.porque}</td>
                  <td>{c.alternativa}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-sm text-[var(--ink-faint)] leading-relaxed max-w-[760px]">
          La fila que aplica a tu caso se determina en el <a href={LINKS.schedule} class="underline underline-offset-2 text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors">Sprint&nbsp;0</a>,
          donde revisamos el proceso y el estado real de los datos antes de recomendar nada.
        </p>
      </div>
    </Section>

    <Section variant="dark">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-6">
          Control, trazabilidad y límites
        </h2>
        <div class="space-y-5 text-white/85 leading-relaxed text-base sm:text-lg">
          <p>
            Automatizar un proceso crítico sin poder reconstruir después qué pasó no es una
            eficiencia, es un riesgo trasladado. Cada implementación deja registro de qué
            información entró, qué propuso el sistema, qué regla o modelo se aplicó, quién
            confirmó y cuándo.
          </p>
          <p>
            Los umbrales de confianza son explícitos y los define el negocio, no el modelo: qué
            casos avanzan solos, cuáles se derivan a revisión y cuáles nunca se automatizan.
            Las decisiones con consecuencia comercial o financiera las sigue tomando una persona
            con atribuciones.
          </p>
        </div>
      </div>
    </Section>

    <Section variant="gray">
      <div class="max-w-[1100px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-4 text-center">
          Dónde la aplicamos
        </h2>
        <p class="text-[var(--ink-faint)] text-base sm:text-lg leading-relaxed mb-10 text-center max-w-[700px] mx-auto">
          Cada etapa del ciclo de venta a cobro tiene su propio punto de entrada para la IA.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {SOLUCIONES.map((sol) => (
            <a
              href={`/soluciones/${sol.slug}/`}
              class="group block rounded-[var(--radius-lg)] border border-[var(--rule)] bg-[var(--panel)] p-6 transition-colors hover:border-[var(--accent-flat)]"
            >
              <span class="eyebrow block mb-2">{sol.fase}</span>
              <span class="font-display font-semibold text-[var(--z-primary)] group-hover:text-[var(--accent)] transition-colors block leading-snug">
                {sol.titulo}
              </span>
            </a>
          ))}
        </div>
      </div>
    </Section>

    <Section variant="white">
      <div class="max-w-[820px] mx-auto">
        <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--z-primary)] mb-10">
          Preguntas frecuentes
        </h2>
        <dl class="space-y-8">
          {faq.map((item) => (
            <div>
              <dt class="font-display text-lg sm:text-xl font-semibold text-[var(--z-primary)] mb-2">
                {item.pregunta}
              </dt>
              <dd class="text-[var(--ink-soft)] leading-relaxed">{item.respuesta}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-12 text-center">
          <LinkButton href={LINKS.schedule} variant="primary" class="w-full sm:w-auto">
            Agenda tu Sprint 0
          </LinkButton>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>

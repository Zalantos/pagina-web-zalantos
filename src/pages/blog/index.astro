---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { blogListSchema, breadcrumbSchema, pageSchema, SITE_URL } from '../../lib/schemas'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const categories = [...new Set(posts.map((post) => post.data.category))]

// Texto normalizado (sin tildes, minúsculas) para búsqueda insensible a acentos
function normalize(text: string): string {
  return text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
}

function formatDate(date: Date): string {
  // timeZone UTC es obligatorio: `pubDate: 2026-09-25` del frontmatter se parsea como
  // medianoche UTC y, al formatearlo en la zona local de Chile (UTC-3/-4), retrocede al
  // día anterior. Sin esto el texto visible contradice al <time datetime> y al JSON-LD.
  return date.toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  })
}

const title = 'Blog de automatización e IA para empresas'
const description =
  'Artículos y casos sobre automatización del ciclo de venta a cobro, integración de sistemas e IA aplicada en empresas chilenas. Con criterio, sin humo.'
const canonical = `${SITE_URL}/blog/`

const migas = [
  { name: 'Inicio', url: `${SITE_URL}/` },
  { name: 'Blog', url: canonical },
]

// El índice declara su contenido: CollectionPage + Blog con cada artículo enumerado
// y su autor apuntando al @id de la persona. Sin esto la página era invisible para
// el grafo de entidades aunque cada post sí tuviera su Article.
const schemas = [
  pageSchema({
    name: title,
    description,
    url: canonical,
    type: 'CollectionPage',
    breadcrumb: migas,
  }),
  blogListSchema(
    posts.map((post) => ({
      title: post.data.title,
      description: post.data.description,
      slug: post.slug,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      author: post.data.author,
    })),
  ),
  breadcrumbSchema(migas),
]
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  extraSchemas={schemas}
>
  <main class="flex-grow w-full pt-16 md:pt-20">
    <section class="w-full relative pt-8 md:pt-12 pb-8 bg-white">
      <div class="section-inner">
        <div class="max-w-2xl">
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-4 text-[#0B2A3C]">
            Blog de automatización e IA para empresas
          </h1>
          <p class="text-lg text-[#6F7A83]">
            Artículos y casos sobre automatización de procesos e inteligencia artificial para empresas.
          </p>

          <form action="/blog/" method="get" role="search" class="mt-8 relative">
            <label for="blog-search" class="sr-only">Buscar artículos</label>
            <svg
              class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-[#6F7A83] pointer-events-none"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
            </svg>
            <input
              id="blog-search"
              type="search"
              name="q"
              placeholder="Buscar por tema, palabra clave o categoría"
              autocomplete="off"
              class="w-full rounded-full border border-[rgba(11,42,60,0.15)] bg-white pl-12 pr-5 py-3 text-base text-[#0B2A3C] placeholder:text-[#6F7A83] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2FBF71]"
            />
          </form>
          {categories.length > 1 && (
            <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría">
              {['Todos', ...categories].map((category, index) => (
                <button
                  type="button"
                  data-category-chip={index === 0 ? '' : category}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  class="rounded-full border border-[rgba(11,42,60,0.15)] px-4 py-1.5 text-sm font-medium text-[#0B2A3C] transition-colors hover:border-[#2FBF71] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2FBF71] aria-pressed:bg-[#0B2A3C] aria-pressed:text-white aria-pressed:border-[#0B2A3C]"
                >
                  {category}
                </button>
              ))}
            </div>
          )}
          <p id="blog-search-status" class="mt-3 text-sm text-[#6F7A83]" role="status" aria-live="polite" hidden></p>
        </div>
      </div>
    </section>

    <div class="w-full h-px bg-[rgba(11,42,60,0.08)]"></div>

    <section class="w-full relative pt-8 pb-14 md:pb-24 bg-[#F1F5F9]">
      <div class="section-inner">
        {posts.length === 0 ? (
          <p class="text-center py-24 text-[#6F7A83]">
            Próximamente nuevos artículos.
          </p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post) => (
              <article
                data-blog-card
                data-category={post.data.category}
                data-search={normalize(`${post.data.title} ${post.data.excerpt} ${post.data.category} ${post.data.tags.join(' ')}`)}
                class="card-flat flex flex-col group transition-all duration-200 hover:shadow-md border-[rgba(11,42,60,0.1)]"
              >
                <div class="p-6 sm:p-8 flex flex-col flex-grow">
                  <span class="text-xs font-semibold tracking-wider uppercase mb-3 text-[#1F7F4A]">
                    {post.data.category}
                  </span>
                  <h2 class="text-xl font-bold leading-snug mb-3 group-hover:text-[#2FBF71] transition-colors duration-200 text-[#0B2A3C]">
                    {post.data.title}
                  </h2>
                  <p class="text-xs mb-4 text-[#6F7A83]">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    {post.data.updatedDate && (
                      <>
                        {' · '}
                        <span class="text-[#1F7F4A] font-medium">
                          Actualizado el{' '}
                          <time datetime={post.data.updatedDate.toISOString()}>
                            {formatDate(post.data.updatedDate)}
                          </time>
                        </span>
                      </>
                    )}
                  </p>
                  <p class="text-sm leading-relaxed flex-grow text-[#6F7A83]">
                    {post.data.excerpt}
                  </p>
                  <div class="mt-6 pt-4 border-t border-[rgba(11,42,60,0.08)]">
                    <a
                      href={`/blog/${post.slug}/`}
                      class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors duration-200 text-[#0B2A3C]"
                      aria-label={`Leer artículo: ${post.data.title}`}
                    >
                      Leer artículo
                      <svg
                        class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
        <p id="blog-no-results" class="text-center py-24 text-[#6F7A83]" hidden>
          No encontramos artículos para tu búsqueda. Prueba con otra palabra clave.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Filtro en cliente por texto (?q=, coincide con el SearchAction del schema WebSite) y por categoría
  const input = document.getElementById('blog-search') as HTMLInputElement | null
  const status = document.getElementById('blog-search-status')
  const noResults = document.getElementById('blog-no-results')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-card]'))
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-chip]'))
  let activeCategory = ''

  const normalize = (text: string): string =>
    text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim()

  function applyFilter(): void {
    const raw = input?.value ?? ''
    const terms = normalize(raw).split(/\s+/).filter(Boolean)
    let visible = 0
    for (const card of cards) {
      const haystack = card.dataset.search ?? ''
      const match =
        terms.every((term) => haystack.includes(term)) &&
        (!activeCategory || card.dataset.category === activeCategory)
      // display inline: las clases flex de la tarjeta anulan el atributo hidden
      card.style.display = match ? '' : 'none'
      if (match) visible += 1
    }
    if (noResults) noResults.hidden = visible > 0 || cards.length === 0
    if (status) {
      const filtering = terms.length > 0 || activeCategory !== ''
      status.hidden = !filtering
      status.textContent = `${visible} de ${cards.length} artículos`
    }
  }

  if (input) {
    input.value = new URLSearchParams(window.location.search).get('q') ?? ''
    input.addEventListener('input', () => {
      applyFilter()
      const url = new URL(window.location.href)
      if (input.value.trim()) url.searchParams.set('q', input.value.trim())
      else url.searchParams.delete('q')
      window.history.replaceState(null, '', url)
    })
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.categoryChip ?? ''
      for (const other of chips) other.setAttribute('aria-pressed', String(other === chip))
      applyFilter()
    })
  }

  applyFilter()
</script>

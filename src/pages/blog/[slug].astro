---
import { getCollection, type CollectionEntry } from 'astro:content'
import BlogLayout from '../../layouts/BlogLayout.astro'
import LinkButton from '../../components/ui/LinkButton.astro'
import { LINKS } from '../../lib/constants'
import { SOLUCIONES } from '../../data/soluciones'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await post.render()

// Solución comercial relacionada: conecta el contenido editorial con las páginas
// que capturan intención de compra. Sin esto el blog no alimenta a ninguna money page.
const solucionRelacionada = post.data.solucion
  ? SOLUCIONES.find((s) => s.slug === post.data.solucion)
  : undefined

// Artículos relacionados: misma categoría primero, luego los más recientes
const relatedPosts = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const sameA = a.data.category === post.data.category ? 1 : 0
    const sameB = b.data.category === post.data.category ? 1 : 0
    return sameB - sameA || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  })
  .slice(0, 3)

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}

function readingTime(body: string): string {
  const words = body.trim().split(/\s+/).length
  const minutes = Math.ceil(words / 200)
  return `${minutes} min de lectura`
}
---
<BlogLayout
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  description={post.data.description}
  slug={post.slug}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  category={post.data.category}
  image={post.data.image}
>
  <main class="flex-grow w-full pt-16 md:pt-20">
    <section class="section-full bg-white">
      <div class="section-inner">
        <div class="max-w-3xl mx-auto text-center">
          <nav class="flex flex-wrap items-center justify-center gap-2 text-xs mb-8" aria-label="Navegación de migas de pan">
            <a href={LINKS.home} class="transition-colors duration-150 text-[#6F7A83]" title="Ir al inicio de zalantos">
              Inicio
            </a>
            <svg
              class="w-3 h-3 text-[#6F7A83]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href={LINKS.blog} class="transition-colors duration-150 text-[#6F7A83]" title="Ver todos los artículos de zalantos">
              Blog
            </a>
            <svg
              class="w-3 h-3 text-[#6F7A83]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span class="text-[#0B2A3C]" aria-current="page">{post.data.seoTitle ?? post.data.title}</span>
          </nav>

          <span class="inline-block text-xs font-semibold tracking-widest uppercase mb-4 text-[#1F7F4A]">
            {post.data.category}
          </span>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-6 text-[#0B2A3C]">
            {post.data.title}
          </h1>

          <div class="flex items-center justify-center gap-4 text-sm text-[#6F7A83]">
            <span>{post.data.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post.body)}</span>
          </div>
        </div>
      </div>
    </section>

    <div class="w-full h-px bg-[rgba(11,42,60,0.08)]"></div>

    <section class="section-full bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <article class="blog-content">
          <Content />
        </article>

        {relatedPosts.length > 0 && (
          <section class="mt-16" aria-labelledby="related-heading">
            <h2 id="related-heading" class="text-2xl font-bold mb-6 text-[#0B2A3C]">Sigue leyendo</h2>
            <ul class="grid grid-cols-1 gap-4">
              {relatedPosts.map((related) => (
                <li>
                  <a
                    href={`/blog/${related.slug}/`}
                    class="block rounded-xl border border-[rgba(11,42,60,0.1)] p-5 transition-shadow duration-200 hover:shadow-md"
                  >
                    <span class="text-xs font-semibold tracking-wider uppercase text-[#1F7F4A]">{related.data.category}</span>
                    <span class="block mt-1 text-base font-bold leading-snug text-[#0B2A3C]">{related.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {solucionRelacionada && (
          <aside class="mt-16 rounded-2xl border border-[var(--rule)] bg-[var(--ground)] p-6 sm:p-8">
            <p class="eyebrow mb-2">Solución relacionada</p>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-[var(--z-primary)] leading-snug mb-3">
              {solucionRelacionada.titulo}
            </h2>
            <p class="text-sm sm:text-base text-[var(--ink-soft)] leading-relaxed mb-5">
              {solucionRelacionada.entradilla}
            </p>
            <a
              href={`/soluciones/${solucionRelacionada.slug}/`}
              class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors"
            >
              Ver cómo lo abordamos <span aria-hidden="true">→</span>
            </a>
          </aside>
        )}

        <aside class="mt-16 mb-8 rounded-2xl p-8 sm:p-10 bg-[rgba(47,191,113,0.06)] border-[1.5px] border-[rgba(47,191,113,0.3)]">
          <p class="text-xs font-semibold tracking-widest uppercase mb-3 text-[#1F7F4A]">
            ¿Te identificas con este problema?
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold leading-snug mb-3 text-[#0B2A3C]">
            Agenda un Sprint 0 sin costo y diseñemos la solución en 1 semana.
          </h2>
          <p class="text-sm leading-relaxed mb-8 text-[#6F7A83]">
            En 5 días de trabajo conjunto diagnosticamos el problema, definimos la arquitectura
            y te entregamos un plan de acción concreto sin compromisos.
          </p>
          <LinkButton href={LINKS.schedule} variant="primary" class="px-8 py-3 text-sm">
            Agenda tu Sprint 0 gratuito
          </LinkButton>
        </aside>

        <div class="pb-12">
          <a
            href={LINKS.blog}
            class="inline-flex items-center gap-2 text-sm font-medium transition-colors duration-150 text-[#6F7A83]"
            title="Ver todos los artículos de Insights & Casos"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
            Ver todos los artículos
          </a>
        </div>
      </div>
    </section>
  </main>
</BlogLayout>

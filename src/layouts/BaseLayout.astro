---
import '../styles/global.css'
import SEOHead from '../components/SEOHead.astro'
import JsonLd from '../components/JsonLd.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  canonical: string
  ogImage?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  author?: string
  bodyClass?: string
  hideHeader?: boolean
  hideFooter?: boolean
  noindex?: boolean
  extraSchemas?: Record<string, unknown>[]
}

const {
  title,
  description,
  canonical,
  ogImage,
  type = 'website',
  pubDate,
  updatedDate,
  author,
  bodyClass = '',
  hideHeader = false,
  hideFooter = false,
  noindex = false,
  extraSchemas = [],
} = Astro.props

const GA_ID = 'G-X2L1QQ8X0D'
const FONTS_URL =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap'
---
<!DOCTYPE html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <meta name="theme-color" content="#0B2A3C" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href={FONTS_URL}
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>

    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      author={author}
      noindex={noindex}
    />

    {extraSchemas.map((schema) => <JsonLd schema={schema} />)}

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || []
      function gtag() { window.dataLayer.push(arguments) }
      gtag('js', new Date())
      gtag('config', GA_ID)
    </script>
  </head>
  <body class={`font-sans antialiased ${bodyClass}`}>
    {!hideHeader && <Header />}
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>

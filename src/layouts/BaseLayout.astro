---
import '../styles/fonts.css'
import '../styles/global.css'
import SEOHead from '../components/SEOHead.astro'
import JsonLd from '../components/JsonLd.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  canonical: string
  ogImage?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  author?: string
  bodyClass?: string
  hideHeader?: boolean
  hideFooter?: boolean
  noindex?: boolean
  extraSchemas?: Record<string, unknown>[]
}

const {
  title,
  description,
  canonical,
  ogImage,
  type = 'website',
  pubDate,
  updatedDate,
  author,
  bodyClass = '',
  hideHeader = false,
  hideFooter = false,
  noindex = false,
  extraSchemas = [],
} = Astro.props

const GA_ID = 'G-X2L1QQ8X0D'
---
<!DOCTYPE html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <meta name="theme-color" content="#0B2A3C" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!--
      Fuentes autohospedadas (src/styles/fonts.css): sin conexiones a terceros ni
      CSS bloqueante. Se precargan las dos variables que pinta el primer viewport
      (Inter en el cuerpo, Space Grotesk en los titulares); IBM Plex Mono solo
      afecta a eyebrows y llega con el CSS. `crossorigin` es obligatorio aunque
      sean del mismo origen: sin él el navegador descargaría la fuente dos veces.
    -->
    <link
      rel="preload"
      href="/fonts/inter-v20-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-v22-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      author={author}
      noindex={noindex}
    />

    {extraSchemas.map((schema) => <JsonLd schema={schema} />)}

    <script is:inline define:vars={{ GA_ID }}>
      // La cola de GA4 se inicializa de inmediato (coste ~0) para no perder
      // eventos, pero el script de Google se inyecta cuando el hilo principal
      // queda libre tras el load o en la primera interacción, lo que ocurra
      // antes. Todo lo que se encole antes se procesa al cargar el script.
      window.dataLayer = window.dataLayer || []
      function gtag() { window.dataLayer.push(arguments) }
      gtag('js', new Date())
      gtag('config', GA_ID)

      var eventosInteraccion = ['pointerdown', 'keydown', 'touchstart', 'scroll']
      var gaSolicitado = false

      function cargarGA() {
        if (gaSolicitado) return
        gaSolicitado = true
        eventosInteraccion.forEach(function (evento) {
          window.removeEventListener(evento, cargarGA)
        })
        var script = document.createElement('script')
        script.async = true
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID
        document.head.appendChild(script)
      }

      eventosInteraccion.forEach(function (evento) {
        window.addEventListener(evento, cargarGA, { once: true, passive: true })
      })

      window.addEventListener('load', function () {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(cargarGA, { timeout: 4000 })
        } else {
          setTimeout(cargarGA, 2000)
        }
      })

      // Medición de conversión: cada clic hacia contacto/agenda o al correo se reporta
      // con la página y el texto del CTA, para saber qué sección convierte.
      document.addEventListener('click', function (event) {
        var enlace = event.target instanceof Element ? event.target.closest('a') : null
        if (!enlace) return

        var href = enlace.getAttribute('href') || ''
        var esContacto = href.indexOf('/contacto/') === 0
        var esCorreo = href.indexOf('mailto:') === 0
        if (!esContacto && !esCorreo) return

        gtag('event', 'cta_contacto', {
          cta_texto: (enlace.textContent || '').trim().slice(0, 80),
          cta_destino: href,
          cta_agendar: href.indexOf('agendar=1') !== -1,
          pagina_origen: window.location.pathname,
        })
      })
    </script>
  </head>
  <body class={`font-sans antialiased ${bodyClass}`}>
    {!hideHeader && <Header />}
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>

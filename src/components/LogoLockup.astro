---
interface Props {
  size?: 'sm' | 'md' | 'lg'
  class?: string
  showText?: boolean
  variant?: 'default' | 'iconOnly'
  priority?: boolean
  href?: string
  tone?: 'navy' | 'white' | 'color'
}

const {
  size = 'md',
  class: className = '',
  showText = true,
  variant = 'default',
  priority = false,
  href,
  tone = 'navy',
} = Astro.props

const sizeConfig = {
  sm: { gap: 10, iconHeight: 40, textClass: 'text-3xl' },
  md: { gap: 10, iconHeight: 24, textClass: 'text-xl' },
  lg: { gap: 12, iconHeight: 32, textClass: 'text-2xl' },
} as const

const config = sizeConfig[size]
const shouldShowText = variant === 'iconOnly' ? false : showText
const fill = tone === 'white' ? '#FFFFFF' : '#0B2A3C'
const textColor = tone === 'white' ? 'text-white' : 'text-[#0B2A3C]'
// Isotipo vectorial del kit digital zalantos (Brand Book v2.2) — reemplaza el PNG raster.
// Variante "Color" del isotipo (public/logos/isotipo-color.svg): trazo bicolor negro + verde de marca.
const fill1 = tone === 'color' ? '#0A0A0A' : fill
const fill2 = tone === 'color' ? '#2FBF71' : fill
// El path es una cinta delgada: se refuerza con stroke del mismo color para que se aprecie a tamaños pequeños.
const strokeAttrs1 = tone !== 'navy' ? ` stroke="${fill1}" stroke-width="36" stroke-linejoin="round"` : ''
const strokeAttrs2 = tone !== 'navy' ? ` stroke="${fill2}" stroke-width="36" stroke-linejoin="round"` : ''

const ContentTag = href ? 'a' : 'div'
---
<ContentTag
  href={href}
  class={`focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2FBF71] focus-visible:ring-offset-2 rounded inline-flex items-center ${className}`}
  style={`gap:${shouldShowText ? config.gap : 0}px`}
  aria-label={href ? 'zalantos - Inicio' : 'zalantos'}
>
  <span
    class="flex-shrink-0 relative block"
    style={`height:${config.iconHeight}px;width:${config.iconHeight}px`}
  >
    <svg
      viewBox="99 1 901 854"
      xmlns="http://www.w3.org/2000/svg"
      width={config.iconHeight}
      height={config.iconHeight}
      role="img"
      aria-label="zalantos"
      set:html={`<path d="M693 184 702 186 706 192 705 201 697 211 523 404 129 825 662 216 661 211 643 212 248 263Z" fill="${fill1}"${strokeAttrs1}/><path d="M970 31 572 482 390 680 391 685 400 685 819 626 454 697 358 714 350 712 346 706 346 699 351 691 496 527 786 219Z" fill="${fill2}"${strokeAttrs2}/>`}
    />
  </span>
  {shouldShowText && (
    <span
      class={`${config.textClass} font-display font-bold ${textColor} flex-shrink-0`}
      style="letter-spacing: -0.035em; line-height: 1;"
    >
      zalantos
    </span>
  )}
</ContentTag>

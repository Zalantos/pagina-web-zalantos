---
interface Props {
  href: string
  variant?: 'navbar' | 'hero'
  class?: string
  betaLabel?: string
  iconOnly?: boolean
}

const {
  href,
  variant = 'hero',
  class: className = '',
  betaLabel,
  iconOnly = false,
} = Astro.props

const baseClasses =
  'inline-flex items-center justify-center gap-2 transition-all duration-300 min-h-[44px] touch-manipulation font-semibold rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2'

const variantClasses = {
  navbar: 'text-xs sm:text-sm px-3 sm:px-4 lg:px-5 py-2.5 whitespace-nowrap',
  hero: 'text-base sm:text-lg md:text-xl px-6 sm:px-8 py-3 sm:py-4',
}[variant]

const iconOnlyClasses = iconOnly
  ? 'w-12 h-12 px-0 py-0 rounded-full justify-center text-center'
  : ''

const aiStyles =
  'bg-[#2FBF71] text-[#0B2A3C] shadow-lg shadow-[#2FBF71]/30 hover:shadow-xl hover:shadow-[#2FBF71]/50 hover:scale-105 active:scale-100 focus-visible:ring-[#2FBF71] relative overflow-hidden before:absolute before:inset-0 before:bg-[#0B2A3C] before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-10'
---
<a
  href={href}
  class={`${baseClasses} ${variantClasses} ${iconOnlyClasses} ${aiStyles} ${className}`}
  aria-label={`Hablar con el Consultor IA${betaLabel ? ` (${betaLabel})` : ''}`}
>
  <svg
    class="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
    />
  </svg>
  {iconOnly ? (
    <span class="sr-only">
      <slot />
      {betaLabel && ` ${betaLabel}`}
    </span>
  ) : (
    <span class="relative z-10 flex items-center gap-2">
      <slot />
      {betaLabel && (
        <span class="rounded-full bg-[#0B2A3C]/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#0B2A3C]">
          {betaLabel}
        </span>
      )}
    </span>
  )}
</a>

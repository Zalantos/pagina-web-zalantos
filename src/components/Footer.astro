---
import { LINKS, CONTACT_EMAIL } from '../lib/constants'

const focusRing = 'focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-flat)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--z-primary)] rounded'
const navLinkClass = `text-white/70 hover:text-[var(--accent-flat)] transition-colors text-sm inline-flex items-center min-h-[44px] md:min-h-0 ${focusRing}`

const navLinks = [
  { href: LINKS.home, label: 'Inicio', title: 'Volver al inicio de zalantos' },
  { href: LINKS.blog, label: 'Blog', title: 'Ver artículos de Insights y Casos de zalantos' },
  { href: LINKS.contact, label: 'Contacto', title: 'Contactar a zalantos para agendar un Sprint 0' },
  { href: LINKS.aiConsultant, label: 'Consultor IA', title: 'Probar el Consultor IA de zalantos' },
]
---
<footer class="w-full bg-[var(--z-primary)] text-white/80 border-t border-[rgba(255,255,255,0.08)]" role="contentinfo">
  <div class="section-inner py-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 md:gap-12 mb-5">
      <div>
        <h3 class="text-xl font-bold text-white mb-1">zalantos</h3>
        <p class="text-white/70 text-sm mb-2">
          Convertimos tus ventas en liquidez
        </p>
        <p class="text-white/70 text-sm break-words">
          <span class="text-white font-semibold">Email:</span>{' '}
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            title="Enviar correo a zalantos"
            class={`text-[var(--accent-flat)] hover:text-[rgba(47,191,113,0.8)] transition-colors break-all sm:break-normal ${focusRing}`}
          >
            {CONTACT_EMAIL}
          </a>
        </p>
      </div>

      <nav aria-label="Navegación del pie de página">
        <ul class="flex flex-wrap gap-x-6 md:gap-x-8 md:pt-1">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} title={link.title} class={navLinkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="border-t border-[rgba(255,255,255,0.08)] pt-4 flex flex-col md:flex-row justify-between items-center gap-2 md:gap-4">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
        <div class="flex items-center gap-2.5">
          <img src="/logos/isotipo-blanco.svg" alt="" width="16" height="15" class="h-[15px] w-auto" aria-hidden="true" />
          <span class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/70">zalantos —2026</span>
        </div>
        <p class="text-white/60 text-sm">
          © 2026 zalantos. Todos los derechos reservados.
        </p>
      </div>
      <a
        href={LINKS.privacy}
        title="Ver política de privacidad de zalantos"
        class={`text-white/60 hover:text-[var(--accent-flat)] transition-colors text-sm min-h-[44px] md:min-h-0 inline-flex items-center ${focusRing}`}
      >
        Privacidad y términos
      </a>
    </div>
  </div>
</footer>

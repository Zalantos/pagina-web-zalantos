---
import { LINKS, NAV_ITEMS, CONTACT_EMAIL, CONTACT_ADDRESS, SOCIAL_LINKS } from '../lib/constants'

const focusRing = 'focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent-flat)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--z-primary)] rounded'
const navLinkClass = `text-white/70 hover:text-[var(--accent-flat)] transition-colors text-sm inline-flex items-center min-h-[44px] md:min-h-0 ${focusRing}`

---
<footer class="w-full bg-[var(--z-primary)] text-white/80 border-t border-[rgba(255,255,255,0.08)]" role="contentinfo">
  <div class="section-inner py-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4 md:gap-12 mb-5">
      <div>
        <div class="flex items-center gap-3 mb-1">
          <h3 class="text-xl font-bold text-white">zalantos</h3>
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            title="Seguir a zalantos en LinkedIn"
            aria-label="Seguir a zalantos en LinkedIn"
            class={`inline-flex items-center justify-center text-white/70 hover:text-[var(--accent-flat)] transition-colors ${focusRing}`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 110-4.13 2.06 2.06 0 010 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
          </a>
        </div>
        <p class="text-white/70 text-sm mb-3 max-w-sm leading-relaxed">
          Automatizamos las actividades del ciclo de venta a cobro para convertir más rápido
          tus ventas en caja.
        </p>
        <address class="not-italic text-white/70 text-sm grid grid-cols-[auto_1fr] gap-x-2 gap-y-1">
          <span class="text-white font-semibold">Email:</span>
          <span class="break-words">
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              title="Enviar correo a zalantos"
              class={`text-[var(--accent-flat)] hover:text-[rgba(47,191,113,0.8)] transition-colors break-all sm:break-normal ${focusRing}`}
            >
              {CONTACT_EMAIL}
            </a>
          </span>
          <span class="text-white font-semibold">Oficina:</span>
          <span>
            {CONTACT_ADDRESS.locality}, {CONTACT_ADDRESS.country}{' '}
            <a
              href={LINKS.contact}
              title="Ver la dirección completa de zalantos"
              class={`text-white/60 hover:text-[var(--accent-flat)] transition-colors ${focusRing}`}
            >
              (ver dirección)
            </a>
          </span>
        </address>
      </div>

      <nav aria-label="Navegación del pie de página">
        <ul class="flex flex-wrap gap-x-6 md:gap-x-8 md:pt-1">
          {NAV_ITEMS.map((link) => (
            <li>
              <a href={link.href} title={link.title} class={navLinkClass}>
                {link.label}
              </a>
            </li>
          ))}
          {/* El glosario se enlaza solo desde el pie: es una sección de referencia,
              no un paso del recorrido comercial que ordena el menú principal. */}
          <li>
            <a
              href={LINKS.glossary}
              title="Ver el glosario del ciclo de venta a cobro"
              class={navLinkClass}
            >
              Glosario
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="border-t border-[rgba(255,255,255,0.08)] pt-4 flex flex-col md:flex-row justify-between items-center gap-2 md:gap-4">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
        <div class="flex items-center gap-2.5">
          <img src="/logos/isotipo-blanco.svg" alt="" width="16" height="15" class="h-[15px] w-auto" aria-hidden="true" />
          <span class="text-[10px] font-medium uppercase tracking-[0.22em] text-white/70">zalantos —2026</span>
        </div>
        <p class="text-white/60 text-sm">
          © 2026 zalantos. Todos los derechos reservados.
        </p>
      </div>
      <a
        href={LINKS.privacy}
        title="Ver política de privacidad de zalantos"
        class={`text-white/60 hover:text-[var(--accent-flat)] transition-colors text-sm min-h-[44px] md:min-h-0 inline-flex items-center ${focusRing}`}
      >
        Privacidad y términos
      </a>
    </div>
  </div>
</footer>

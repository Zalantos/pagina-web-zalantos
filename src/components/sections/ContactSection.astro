---
import ContactPanel from '../ContactPanel'
import { CONTACT_ADDRESS, CONTACT_EMAIL } from '../../lib/constants'
---
<section class="w-full bg-[var(--ground)] py-16 sm:py-20 md:py-32" aria-labelledby="contact-heading">
  <div class="w-full px-4 sm:px-6 md:px-12 max-w-[1200px] mx-auto">
    <div class="max-w-[820px] mx-auto text-center mb-12 md:mb-16">
      <h1
        id="contact-heading"
        class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--z-primary)] leading-[1.1] mb-6"
      >
        Hablemos
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed">
        Escríbenos o agenda directamente el Sprint 0
      </p>
    </div>

    <ContactPanel client:visible />

    <div class="max-w-[900px] mx-auto mt-16 md:mt-20 pt-10 border-t border-[var(--rule)] text-center">
      <h2 class="font-display text-lg font-semibold text-[var(--z-primary)] mb-3">
        Dónde estamos
      </h2>
      <address class="not-italic text-[var(--ink-soft)] text-sm sm:text-base leading-relaxed">
        <p>{CONTACT_ADDRESS.street} · {CONTACT_ADDRESS.locality}, {CONTACT_ADDRESS.country}</p>
        <p class="mt-1">
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-[var(--accent)] hover:text-[var(--z-primary)] transition-colors"
          >
            {CONTACT_EMAIL}
          </a>
        </p>
      </address>
    </div>
  </div>
</section>

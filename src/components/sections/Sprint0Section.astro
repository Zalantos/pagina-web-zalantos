---
import Section from '../ui/Section.astro'
import LinkButton from '../ui/LinkButton.astro'
import { LINKS } from '../../lib/constants'
import AiQuickAsk from '../AiQuickAsk'

const DELIVERABLES = [
  'Claridad sobre tu problema y sus causas',
  'Opciones de solución concretas, alineadas a tu operación',
  'Próximos pasos y roadmap sugerido, sin compromiso',
]
---
<Section id="sprint-0" variant="white">
  <div class="max-w-[1100px] mx-auto w-full space-y-8 md:space-y-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[rgba(47,191,113,0.1)] border border-[rgba(47,191,113,0.2)]">
      <span class="w-2 h-2 rounded-full bg-[var(--accent-flat)]" aria-hidden="true"></span>
      <span class="text-xs font-semibold text-[var(--accent)] uppercase tracking-wide">
        Sin costo · Sin compromiso
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 items-start gap-y-10 md:gap-x-16 lg:gap-x-24">
      <div class="space-y-6">
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--z-primary)] leading-tight">
          Prueba el Sprint&nbsp;0
        </h2>

        <p class="text-base sm:text-lg md:text-xl text-[var(--ink-soft)] leading-relaxed max-w-lg">
          Agendemos una reunión para entender tu dolor o necesidad. Te entregamos un diagnóstico resumido y una propuesta con las opciones más adecuadas para tu negocio.
        </p>
      </div>

      <div>
        <p class="text-sm sm:text-base font-semibold text-[var(--ink-soft)] uppercase tracking-wider leading-tight md:pt-[0.6rem] mb-4">
          Qué recibes
        </p>
        <ul class="space-y-3">
          {DELIVERABLES.map((text) => (
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 text-[var(--accent-flat)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-[var(--z-primary)] text-base sm:text-lg leading-snug">
                {text}
              </span>
            </li>
          ))}
        </ul>

        <div class="pt-8">
          <LinkButton
            href={LINKS.schedule}
            variant="primary"
            class="w-full sm:w-auto shadow-none"
          >
            Agenda tu Sprint 0
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </LinkButton>
        </div>
      </div>
    </div>

    <div class="text-center max-w-2xl mx-auto pt-2 space-y-4">
      <p class="text-sm sm:text-base text-[var(--ink-soft)] leading-relaxed">
        ¿Prefieres no agendar? Cuéntale tu caso a nuestro Consultor IA y explora posibles caminos de solución.
      </p>
      <AiQuickAsk client:visible />
    </div>
  </div>
</Section>

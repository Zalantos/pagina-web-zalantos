---
import Section from '../ui/Section.astro'

// Top 3 según columna B (ranking) del informe "Casos_Automatizacion_Zalantos".
// Fuente y URL de la fuente = columnas H/I del informe.
// IMPORTANTE: son casos públicos de terceros, NO proyectos de zalantos. La atribución
// debe permanecer visible en todos los estados y breakpoints (ver bloque "Fuente").
const cases = [
  {
    rank: 1,
    industria: 'Telecomunicaciones',
    title:
      'IA eleva 40% las ventas inbound a costo marginal',
    summary:
      'Entel Connect Center (Perú) recibía más de 600.000 llamadas al mes y solo podía auditar una fracción mínima. Un agente de IA analiza el 100% de las conversaciones y detecta oportunidades de venta inbound obteniendo un aumento de un 40% de éstas a un costo marginal mínimo.',
    fuente: 'McKinsey & Company',
    fuenteUrl:
      'https://www.mckinsey.com/industries/technology-media-and-telecommunications/how-we-help-clients/transforming-every-call-into-an-opportunity-how-entel-connect-reimagined-customer-conversations-with-mckinsey-and-google-cloud',
    image: '/images/caso-entel-ai-audio.jpg',
    imageAlt: 'Operador de contact center analizando conversaciones de clientes',
    imageWidth: 800,
    imageHeight: 436,
  },
  {
    rank: 2,
    industria: 'Consultoría',
    title: '30% menos horas buscando información: la IA interna de McKinsey',
    summary:
      'McKinsey construyó Lilli, una plataforma de IA con años de conocimiento de la firma, que actualmente utiliza más del 70% de sus empleados y ahorra el 30% del tiempo en el proceso de recopilación de información y mejora más del 20% la calidad y precisión del contenido.',
    fuente: 'McKinsey & Company',
    fuenteUrl:
      'https://www.mckinsey.com/capabilities/tech-and-ai/how-we-help-clients/rewiring-the-way-mckinsey-works-with-lilli',
    image: '/images/caso-mckinsey-lilli.jpg',
    imageAlt: 'Equipo de consultoría trabajando con documentación digital',
    imageWidth: 800,
    imageHeight: 758,
  },
  {
    rank: 3,
    industria: 'Industrial / Manufactura',
    title: 'US$6 millones ahorrados al automatizar cuentas por pagar',
    summary:
      'Johnson Controls automatizó su gestión mensual de 200.000 transacciones de cuentas por pagar con inteligencia artificial. Esto disminuyó los errores de procesamiento en más de un 80% y permitió liberar recursos generando 6 millones de dólares en ahorros directos en solo seis meses',
    fuente: 'UiPath',
    fuenteUrl:
      'https://www.uipath.com/resources/automation-case-studies/johnson-controls-is-unlocking-substantial-savings-with-intelligent-automation',
    image: '/images/caso-johnson-controls-ap.jpg',
    imageAlt: 'Planta industrial con procesos administrativos automatizados',
    imageWidth: 800,
    imageHeight: 800,
  },
]

// Clases del resumen: visible siempre en móvil (sin hover disponible),
// colapsado y revelado por hover/foco desde md en adelante.
const summaryClass = [
  'text-white/90 text-sm leading-relaxed overflow-hidden pt-3 transition-all duration-300',
  'md:max-h-0 md:pt-0 md:opacity-0',
  'md:group-hover:max-h-64 md:group-hover:pt-3 md:group-hover:opacity-100',
  'md:group-focus-within:max-h-64 md:group-focus-within:pt-3 md:group-focus-within:opacity-100',
].join(' ')
---
<Section variant="gray">
  <div class="text-center mb-12 md:mb-16">
    <span class="eyebrow inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--z-border)] mb-4">
      Referentes de la industria
    </span>
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--z-primary)] mb-4 px-4">
      Cómo las empresas líderes se están transformando
    </h2>
    <p class="text-base sm:text-lg md:text-xl text-[var(--ink-faint)] max-w-[700px] mx-auto px-4">
      Casos públicos de otras compañías, documentados por sus propias fuentes. Son la evidencia de que estas fugas tienen solución.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-[1200px] mx-auto">
    {cases.map((c) => (
      <article class="group relative flex overflow-hidden rounded-[var(--radius-lg)] min-h-[420px] md:h-[440px] focus-within:ring-2 focus-within:ring-[var(--accent-flat)] focus-within:ring-offset-2">
        {/* capa foto: zoom-in por defecto, zoom-out al pasar el mouse */}
        <img
          src={c.image}
          alt={c.imageAlt}
          width={c.imageWidth}
          height={c.imageHeight}
          class="absolute inset-0 w-full h-full object-cover scale-125 group-hover:scale-100 group-focus-within:scale-100 transition-transform duration-700 ease-out"
          loading="lazy"
          decoding="async"
        />

        {/* scrim oscuro para legibilidad del texto */}
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/65 to-black/25 md:via-black/40 md:to-transparent"></div>
        {/* refuerzo de scrim solo cuando se despliega el resumen en desktop */}
        <div class="absolute inset-0 bg-black/0 md:group-hover:bg-black/35 md:group-focus-within:bg-black/35 transition-colors duration-300"></div>

        <div class="relative z-10 flex w-full flex-col justify-end p-6">
          <span class="eyebrow !text-white/70 mb-2">{c.industria}</span>

          <h3 class="text-white text-lg sm:text-xl font-bold leading-snug">
            {c.title}
          </h3>

          <p class={summaryClass}>
            {c.summary}
          </p>

          {/* La atribución nunca se oculta: estos resultados no son de zalantos */}
          <a
            href={c.fuenteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-[var(--accent-flat)] hover:text-white transition-colors focus:outline-none focus-visible:underline"
          >
            Fuente: {c.fuente} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</Section>

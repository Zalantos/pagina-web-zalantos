---
import { ogImagePathFromCanonical } from '../lib/og'

export interface Props {
  title: string
  description: string
  canonical: string
  ogImage?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  author?: string
  noTitleSuffix?: boolean
  noindex?: boolean
}

const {
  title,
  description,
  canonical,
  ogImage,
  type = 'website',
  pubDate,
  updatedDate,
  author = 'zalantos',
  noTitleSuffix = false,
  noindex = false,
} = Astro.props

// Nombre de página sin el sufijo del sitio (evita "| zalantos | zalantos")
const pageTitle = title.replace(/\s*\|\s*zalantos\s*$/i, '')
const fullTitle = noTitleSuffix ? title : `${pageTitle} | zalantos`
// Sin imagen explícita, cada página usa la suya: /og/<slug>.png, generada en build
// desde su H1 y su descripción reales (scripts/og).
const ogImageResuelta = ogImage ?? ogImagePathFromCanonical(canonical)
const absoluteOgImage = ogImageResuelta.startsWith('http')
  ? ogImageResuelta
  : `https://zalantos.com${ogImageResuelta}`
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
{/* Una página noindex no declara canonical: son señales contradictorias para el
    rastreador (no indexes esto / esta es la versión a indexar). El canonical se usa igual
    para resolver og:url y la imagen OG. */}
{!noindex && <link rel="canonical" href={canonical} />}

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content="zalantos" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

{type === 'article' && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === 'article' && (
  <meta property="article:author" content={author} />
)}

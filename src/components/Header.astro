---
import LogoLockup from './LogoLockup.astro'
import { LINKS } from '../lib/constants'

interface Props {
  extraLink?: { href: string; label: string }
}

const { extraLink } = Astro.props

const pathname = Astro.url.pathname
const section = Astro.url.searchParams.get('section') || 'home'
const isHome = pathname === '/' || pathname === ''
const isBlog = pathname.startsWith('/blog')
const isHomeActive = isHome && section === 'home'
---
<nav
  class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-[#0B2A3C]/10"
  role="navigation"
  aria-label="Navegación principal"
>
  <div class="w-full px-2 sm:px-4 md:px-12 lg:px-16">
    <div class="max-w-[1400px] mx-auto flex items-center justify-between h-16 md:h-20">
      <div class="flex-shrink-0">
        <div class="sm:hidden">
          <LogoLockup size="sm" variant="iconOnly" priority tone="color" href={LINKS.home} />
        </div>
        <div class="hidden sm:block">
          <LogoLockup size="sm" priority tone="color" href={LINKS.home} class="flex-shrink-0" />
        </div>
      </div>

      <div class="flex gap-1.5 sm:gap-2 lg:gap-8 items-center flex-shrink-0">
        <div class="flex gap-1 sm:gap-2 lg:gap-8 flex-shrink-0">
          <a
            href={LINKS.home}
            class={`text-sm font-medium transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2FBF71] focus-visible:ring-offset-2 focus-visible:ring-offset-white rounded px-1.5 sm:px-2 lg:px-0 flex-shrink-0 border-b-2 ${isHomeActive ? 'text-[#0B2A3C] border-[#2FBF71]' : 'text-[#0B2A3C]/60 hover:text-[#0B2A3C] border-transparent'}`}
            aria-current={isHomeActive ? 'page' : undefined}
            aria-label="Inicio"
          >
            <svg
              class="w-5 h-5 block lg:hidden flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span class="hidden lg:block">Inicio</span>
          </a>

          <a
            href={LINKS.blog}
            class={`text-sm font-medium transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-[#2FBF71] focus-visible:ring-offset-2 focus-visible:ring-offset-white rounded px-1.5 sm:px-2 lg:px-0 flex-shrink-0 border-b-2 ${isBlog ? 'text-[#0B2A3C] border-[#2FBF71]' : 'text-[#0B2A3C]/60 hover:text-[#0B2A3C] border-transparent'}`}
            aria-current={isBlog ? 'page' : undefined}
            aria-label="Blog"
          >
            <svg
              class="w-5 h-5 block lg:hidden flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="hidden lg:block">Blog</span>
          </a>
        </div>

        {extraLink && (
          <div class="hidden lg:block">
            <a
              href={extraLink.href}
              class="text-sm font-semibold text-[#0B2A3C] transition-colors hover:text-[#2FBF71]"
              aria-label={extraLink.label}
            >
              {extraLink.label}
            </a>
          </div>
        )}

        <div class="flex flex-wrap items-center gap-1.5 sm:gap-3 justify-end w-full sm:w-auto">
          <a
            href={LINKS.contact}
            class="btn-primary hidden sm:inline-flex text-xs sm:text-sm px-3 sm:px-4 lg:px-6 py-2.5 whitespace-nowrap"
            aria-label="Ir a página de contacto"
          >
            Contacto
          </a>

          <a
            href={LINKS.contact}
            class="sm:hidden inline-flex w-11 h-11 rounded-full bg-[#2FBF71] shadow-lg items-center justify-center text-[#0B2A3C] border border-[#0B2A3C]/10"
            aria-label="Ir a página de contacto"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              role="img"
            >
              <circle cx="32" cy="32" r="28" />
              <path d="M16 24h32c2.2 0 4 1.8 4 4v14c0 2.2-1.8 4-4 4H16c-2.2 0-4-1.8-4-4V28c0-2.2 1.8-4 4-4z" />
              <path d="M12 26l20 12 20-12" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

---
import type { LinkedInCampaignContent } from '../../types/linkedinCampaignLanding'

interface Props {
  content: LinkedInCampaignContent
}

const { content } = Astro.props
const {
  eyebrow,
  headline,
  subheadline,
  bullets,
  primaryCta,
  secondaryCta,
  chips,
  trustLine,
  visual,
  footerLine,
  qualifySection,
} = content

const bulletsToShow = bullets.slice(0, 3)

const EXTERNAL_PREFIXES = ['http://', 'https://', 'mailto:', 'tel:']
function isExternalHref(href: string) {
  return EXTERNAL_PREFIXES.some((prefix) => href.startsWith(prefix))
}
---
<div class="relative min-h-[100dvh] min-h-svh overflow-x-hidden bg-white text-[#0B2A3C]">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_20%_-10%,rgba(63,169,245,0.18),transparent_60%)]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_80%_at_80%_20%,rgba(47,191,113,0.12),transparent_55%)]"
  ></div>

  <main class="relative z-10 flex flex-1 flex-col pt-[5rem]">
    <div class="mx-auto flex min-h-[calc(100dvh-5rem)] w-full max-w-[1400px] flex-col gap-8 px-4 py-8 sm:px-6 sm:py-10 lg:flex-row lg:items-stretch lg:gap-10 lg:px-10 lg:py-8">
      <div class="flex flex-1 flex-col justify-center gap-5 lg:max-w-[52%]">
        <p class="inline-flex w-fit items-center rounded-full border border-[#E6ECF1] bg-[#F1F5F9] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.3em] text-[#6F7A83]">
          {eyebrow}
        </p>
        <h1 class="text-[clamp(1.9rem,2.4vw+1.1rem,3rem)] font-bold leading-[1.15] tracking-tight text-[#0B2A3C]">
          {headline}
        </h1>
        <p class="max-w-xl text-base leading-relaxed text-[#3D5566] sm:text-[1rem]">
          {subheadline}
        </p>

        {bulletsToShow.length > 0 && (
          <ul class="space-y-2 text-sm text-[#3D5566]">
            {bulletsToShow.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2 w-2 rounded-full bg-[#2FBF71]"></span>
                <span class="leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        )}

        <div class="flex max-w-xl flex-col items-center gap-4 pt-2">
          <a
            href={primaryCta.href}
            class="btn-primary w-full justify-center rounded-[var(--radius-lg)] px-6 py-4 text-center text-base sm:w-fit sm:text-lg"
            target={isExternalHref(primaryCta.href) ? '_blank' : undefined}
            rel={isExternalHref(primaryCta.href) ? 'noopener noreferrer' : undefined}
          >
            {primaryCta.label}
          </a>
          {secondaryCta && (
            <div class="w-full rounded-2xl border border-[#E6ECF1] bg-[#F1F5F9] p-4 text-center">
              <p class="mb-3 text-sm leading-relaxed text-[#3D5566]">
                ¿Tienes dudas o no sabes si vale la pena agendar el Sprint 0? Habla con nuestro agente de IA y aclara tu caso antes de reservar.
              </p>
              <a
                href={secondaryCta.href}
                class="inline-flex items-center justify-center rounded-[var(--radius-lg)] border border-[#2FBF71] px-4 py-2 text-xs font-semibold text-[#0B2A3C] transition-colors duration-200 hover:bg-[#2FBF71] hover:text-[#0B2A3C]"
                target={isExternalHref(secondaryCta.href) ? '_blank' : undefined}
                rel={isExternalHref(secondaryCta.href) ? 'noopener noreferrer' : undefined}
              >
                {secondaryCta.label}
              </a>
            </div>
          )}
        </div>

        {trustLine && <p class="text-sm text-[#6F7A83]">{trustLine}</p>}

        {chips.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-2">
            {chips.map((chip) => (
              <span class="rounded-full border border-[#E6ECF1] bg-[#F1F5F9] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-[#3D5566]">
                {chip}
              </span>
            ))}
          </div>
        )}
      </div>

      <div class="flex flex-1 flex-col justify-center lg:max-w-[48%]">
        <div class="card-flat border border-[rgba(11,42,60,0.08)] bg-white p-6 shadow-[0_25px_50px_-12px_rgba(15,23,42,0.3)]">
          <div class="flex items-start justify-between gap-4 border-b border-[rgba(11,42,60,0.05)] pb-4">
            <div>
              <h2 class="text-lg font-semibold text-[#0B2A3C]">{visual.title}</h2>
              {visual.subtitle && (
                <p class="text-sm text-[#3D5566]">{visual.subtitle}</p>
              )}
            </div>
            {visual.badge && (
              <span class="rounded-md border border-[#2FBF71]/30 bg-[#2FBF71]/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-[#0B2A3C]">
                {visual.badge}
              </span>
            )}
          </div>

          <ol class="mt-5 space-y-5">
            {visual.steps.map((step, index) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-[#E6ECF1] bg-[#F1F5F9] text-sm font-semibold text-[#0B2A3C]">
                  {index + 1}
                </span>
                <div class="flex-1">
                  <p class="font-semibold text-[#0B2A3C]">{step.label}</p>
                  {step.detail && (
                    <p class="text-sm text-[#6F7A83]">{step.detail}</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    {qualifySection && (
      <section class="border-t border-[rgba(11,42,60,0.06)] bg-[#F1F5F9] px-4 py-10 sm:px-6 lg:px-10">
        <div class="mx-auto max-w-[900px]">
          <h2 class="mb-6 text-base font-semibold uppercase tracking-[0.15em] text-[#0B2A3C]">
            {qualifySection.title}
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {qualifySection.bullets.map((item) => (
              <li class="flex items-start gap-3 rounded-xl border border-[#E6ECF1] bg-white px-4 py-3 text-sm text-[#3D5566]">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[#2FBF71]"></span>
                <span class="leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {footerLine && (
      <footer class="border-t border-[var(--z-border)] px-4 py-3 sm:px-6 lg:px-10">
        <p class="text-center text-[11px] uppercase tracking-[0.3em] text-[#6F7A83]">
          {footerLine}
        </p>
      </footer>
    )}
  </main>
</div>

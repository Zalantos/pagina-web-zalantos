RewriteEngine On
RewriteBase /

# Redirigir www a sin www
RewriteCond %{HTTP_HOST} ^www\.zalantos\.com [NC]
RewriteRule ^(.*)$ https://zalantos.com/$1 [L,R=301]

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Si la URL no tiene trailing slash y corresponde a un directorio con index.html,
# redirigir con slash para mantener canonical consistente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]+|/)$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Servir index.html para rutas tipo /blog/slug/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)$ /$1/index.html [L]

# Página 404 (Astro emite /404.html en la raíz, incluso con build.format: 'directory')
ErrorDocument 404 /404.html

# Cache agresivo para assets estáticos
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|png|jpg|jpeg|gif|webp|svg|woff2|woff|ttf|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compresión gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
